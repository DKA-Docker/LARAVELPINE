#!/usr/bin/env bash
set -euo pipefail

# =========================
# Config (env override-able)
# =========================
APP_NAME="${APP_NAME:-Laravel}"

# DB creds
DB_HOST="${DB_HOST:-127.0.0.1}"
DB_PORT="${DB_PORT:-3306}"
DB_NAME="${DB_DATABASE:-laravel}"
DB_USER="${DB_USERNAME:-laravel}"
DB_PASS="${DB_PASSWORD:-laravel}"

# Paths
BACKUP_DIR="${BACKUP_DIR:-/var/www/database/backups}"
ASSET_DIR="${ASSET_DIR:-/var/www/storage/app/public}"

# Flags
DO_DB=false
DO_ASSET=false
AUTO_LATEST=false
NO_PROMPT=false

# =========================
# Helpers
# =========================
log() { printf "[%s] %s\n" "$(date '+%H:%M:%S')" "$*"; }
die() { printf "ERROR: %s\n" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: $(basename "$0") [--db] [--asset] [--latest] [--yes]

Options:
  --db        Restore database dari file *_db_mariadb_*.sql.gz
  --asset     Restore asset upload (file) dari file *_assets_*.tar.gz
  --latest    Otomatis ambil file paling baru per kategori (skip menu)
  --yes       Non-interaktif (auto 'yes' untuk konfirmasi)

Env yang dipakai (default):
  APP_NAME=${APP_NAME}
  BACKUP_DIR=${BACKUP_DIR}
  ASSET_DIR=${ASSET_DIR}
  DB_* (HOST=${DB_HOST} PORT=${DB_PORT} NAME=${DB_NAME} USER=${DB_USER})
EOF
}

confirm() {
  $NO_PROMPT && return 0
  read -r -p "$1 [y/N]: " ans
  [[ "${ans:-}" == "y" || "${ans:-}" == "Y" ]]
}

pick_file_menu() {
  # $1 = glob pattern, return via echo
  local pattern="$1"
  mapfile -t files < <(ls -1t $pattern 2>/dev/null || true)
  [[ ${#files[@]} -gt 0 ]] || die "Tidak ada file cocok pattern: $pattern"

  echo "Available files (newest → oldest):"
  PS3="Pilih file (angka): "
  local options=()
  local f
  for f in "${files[@]}"; do
    local size; size="$(du -h "$f" | awk '{print $1}')"
    options+=("$(basename "$f") ($size)")
  done

  select choice in "${options[@]}"; do
    [[ -n "${choice:-}" ]] || { echo "Pilihan tidak valid."; continue; }
    # ambil token pertama = nama file (sebelum spasi ukuran)
    local fname="${choice%% *}"
    echo "$BACKUP_DIR/$fname"
    break
  done
}

latest_file() {
  # $1 = glob pattern
  ls -1t $1 2>/dev/null | head -n1 || true
}

ensure_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Command tidak ditemukan: $1"
}

# =========================
# Arg parsing
# =========================
[[ $# -gt 0 ]] || { usage; exit 1; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --db) DO_DB=true; shift ;;
    --asset) DO_ASSET=true; shift ;;
    --latest) AUTO_LATEST=true; shift ;;
    --yes|-y) NO_PROMPT=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "Argumen tidak dikenal: $1 (lihat --help)";;
  esac
done

$DO_DB || $DO_ASSET || { usage; exit 1; }

# =========================
# Pre-flight
# =========================
[[ -d "$BACKUP_DIR" ]] || die "BACKUP_DIR tidak ada: $BACKUP_DIR"

# pilih client mariadb/mysql
DB_CLIENT=""
if command -v mariadb >/dev/null 2>&1; then
  DB_CLIENT="mariadb"
elif command -v mysql >/dev/null 2>&1; then
  DB_CLIENT="mysql"
fi
$DO_DB && [[ -n "$DB_CLIENT" ]] || true
$DO_DB && ensure_cmd gunzip
$DO_ASSET && ensure_cmd tar

ESCAPED_DB_PASSWORD="$(printf '%s' "$DB_PASS" | sed 's/[&/\\]/\\&/g')"

# =========================
# Restore DB
# =========================
restore_db() {
  local pattern="$BACKUP_DIR/${APP_NAME}_db_mariadb_*.sql.gz"
  local file=""

  if $AUTO_LATEST; then
    file="$(latest_file "$pattern")"
    [[ -n "$file" ]] || die "Tidak ada file DB backup untuk pattern: $pattern"
    log "Auto-pick DB file: $(basename "$file")"
  else
    file="$(pick_file_menu "$pattern")"
  fi

  log "Restore DB ke '$DB_NAME' dari: $file"
  confirm "Lanjut restore DB? Ini akan menimpa data di database '$DB_NAME'." || { log "Batal restore DB."; return 0; }

  # Catatan: dump dibuat dengan --databases "$DB_NAME"
  # Restore dengan database default tetap aman.
  gunzip -c "$file" | "$DB_CLIENT" -h"$DB_HOST" -P"$DB_PORT" -u"$DB_USER" -p"$ESCAPED_DB_PASSWORD" "$DB_NAME"

  log "✅ Restore DB selesai."
}

# =========================
# Restore Asset
# =========================
restore_asset() {
  local pattern="$BACKUP_DIR/${APP_NAME}_assets_*.tar.gz"
  local file=""

  if $AUTO_LATEST; then
    file="$(latest_file "$pattern")"
    [[ -n "$file" ]] || die "Tidak ada file asset backup untuk pattern: $pattern"
    log "Auto-pick Asset file: $(basename "$file")"
  else
    file="$(pick_file_menu "$pattern")"
  fi

  log "Restore Asset ke: $ASSET_DIR dari: $file"
  [[ -d "$ASSET_DIR" ]] || { log "ASSET_DIR belum ada, membuat: $ASSET_DIR"; mkdir -p "$ASSET_DIR"; }

  # Pre-backup isi ASSET_DIR biar aman
  local ts pre_backup
  ts="$(date +%d-%m-%Y_%H-%M-%S)"
  pre_backup="$BACKUP_DIR/${APP_NAME}_pre-restore-assets_${ts}.tar.gz"

  confirm "Backup isi ASSET_DIR sekarang (→ $(basename "$pre_backup"))?" && {
    log "Membackup isi lama asset → $pre_backup"
    tar -czf "$pre_backup" -C "$ASSET_DIR" . || true
  }

  confirm "Lanjut extract dan overwrite isi $ASSET_DIR?" || { log "Batal restore asset."; return 0; }

  # Extract (backup dibuat: tar -czf file -C ASSET_DIR .) → extract relatif ke ASSET_DIR
  tar -xzf "$file" -C "$ASSET_DIR"

  log "✅ Restore Asset selesai."
}

# =========================
# Execute
# =========================
$DO_DB && restore_db
$DO_ASSET && restore_asset

log "Done."
