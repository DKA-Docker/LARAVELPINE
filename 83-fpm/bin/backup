#!/bin/bash

APP_NAME=${APP_NAME:-Laravel}
# Set database credentials
DB_HOST=${DB_HOST:-127.0.0.1}
DB_PORT=${DB_PORT:-3306}
DB_NAME=${DB_DATABASE:-laravel}
DB_USER=${DB_USERNAME:-laravel}
DB_PASS=${DB_PASSWORD:-laravel}
# Set default values if environment variables are not provided
BACKUP_DIR="/var/www/database/backups"
# shellcheck disable=SC1001
DATE=$(date +\%d-\%m-\%Y_\%H-\%M-\%S)
BACKUP_FILE="$BACKUP_DIR/${APP_NAME}_databases_$DATE.sql.gz"
# Create a backup directory if it doesn't exist
mkdir -p $BACKUP_DIR
echo "Backing up all databases..."
# Create a backup of all databases and compress it into a .sql.gz file using mariadb tools
ESCAPED_DB_PASSWORD=$(printf '%s' "$DB_PASS" | sed 's/[&/]/\\&/g')
mariadb-dump -h"$DB_HOST" -P"$DB_PORT" -u $DB_USER -p"$ESCAPED_DB_PASSWORD" --databases $DB_NAME --lock-all-tables --add-drop-table --routines --triggers --events --verbose --force | gzip -9 > "$BACKUP_FILE"

if [ $? -eq 0 ]; then
    echo "Backup completed successfully: $BACKUP_FILE"
else
    echo "Backup failed."
fi
